# Compass — İlham Pusulam ortam değişkenleri
# Bu dosyayı .env olarak kopyala ve gerçek değerleri yaz.

# Backend AI proxy URL (opsiyonel — varsayılan: Vercel fallback'i kullanılır)
EXPO_PUBLIC_AI_PROXY_URL=https://compassv4fixed3.vercel.app/api/ask

# Vercel serverless fonksiyonu bu anahtarı kullanır.
# https://console.anthropic.com adresinden al.
# Vercel Dashboard → Project Settings → Environment Variables'a ekle.
ANTHROPIC_API_KEY=sk-ant-your-key-here
